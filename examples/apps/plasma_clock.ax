# @name Plasma Clock
# @desc Clock over an animated plasma cloud
# @author Anthonyrr98
# @version 1.0
# @config speed slider "Background speed" default=35 min=5 max=150 step=5 unit=%
# @config tint color "Text colour" default=#FFFFFF
# @config show number "Duration" default=12 min=3 max=120 unit=s

class PlasmaClockApp
  var fx, label, tint, dwell, last_second
  def init()
    self.fx = {"speed": store.get("speed") / 100.0, "palette": "Ocean"}
    self.label = "--:--"
    self.tint = store.get("tint")
    self.dwell = store.get("show") * 1000
    self.last_second = -1
  end
  def loop()
    var s = second()
    if s != self.last_second
      self.last_second = s
      var m = minute()
      self.label = str(hour()) + ":" + (m < 10 ? "0" + str(m) : str(m))
    end
  end
  def draw()
    effect("PlasmaCloud", self.fx)
    text((width() - text_ink_width(self.label)) / 2, 6, self.label, self.tint)
  end
  def duration()
    return self.dwell
  end
end
return PlasmaClockApp()
