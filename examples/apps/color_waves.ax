# @name Color Waves
# @desc Flowing rainbow colour waves
# @author Anthonyrr98
# @version 1.0
# @config speed slider "Speed" default=80 min=10 max=300 step=5 unit=%
# @config show number "Duration" default=12 min=3 max=120 unit=s

class ColorWavesApp
  var fx, dwell
  def init()
    self.fx = {"speed": store.get("speed") / 100.0, "palette": "Rainbow"}
    self.dwell = store.get("show") * 1000
  end
  def draw()
    effect("ColorWaves", self.fx)
  end
  def duration()
    return self.dwell
  end
end
return ColorWavesApp()
